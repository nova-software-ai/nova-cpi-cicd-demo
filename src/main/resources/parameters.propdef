<?xml version="1.0" encoding="UTF-8"?><parameters><parameter><key/><name>GEOCODING_URL</name><type>xsd:string</type><isRequired>false</isRequired><constraint/><description>Open-Meteo geocoding endpoint</description><additionalMetadata/></parameter><parameter><key/><name>FORECAST_URL</name><type>xsd:string</type><isRequired>false</isRequired><constraint/><description>Open-Meteo forecast endpoint</description><additionalMetadata/></parameter><parameter><key/><name>HTTP_TIMEOUT_MS</name><type>xsd:string</type><isRequired>false</isRequired><constraint/><description>Timeout for the Open-Meteo calls (ms)</description><additionalMetadata/></parameter><parameter><key/><name>LOG_PAYLOADS</name><type>xsd:string</type><isRequired>false</isRequired><constraint/><description>true = write request/downstream/output payloads as MPL attachments</description><additionalMetadata/></parameter></parameters>